# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored and should never be committed.

# --- MySQL database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=""
DB_NAME=tinytods

# --- Admin auth ---
# Any long random string works — used to sign admin session JWTs.
# Generate one with: openssl rand -base64 32
JWT_SECRET=replace-this-with-a-long-random-string

# Optional: require this invite code on the admin signup page, so random
# visitors can't create their own admin account on a public deployment.
# Leave blank to allow open signup (fine for local development).
ADMIN_SIGNUP_CODE=GOSXDQ
